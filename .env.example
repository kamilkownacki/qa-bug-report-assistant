# Copy to .env in the repository root. Never commit .env.
# QA_MODE: auto = use configured provider or demo, demo = always offline, ai = require a live provider.
# QA_PROVIDER: auto prefers Gemini, then OpenAI-compatible fallback.
QA_MODE=auto
QA_PROVIDER=auto

# Recommended: Gemini 3.6 Flash gives better report-writing quality than Flash-Lite while remaining available on Google's free tier, subject to current limits/terms.
QA_GEMINI_API_KEY=
QA_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
QA_GEMINI_MODEL=gemini-3.6-flash

# Optional OpenAI-compatible fallback / alternative.
QA_AI_API_KEY=
QA_AI_BASE_URL=https://api.openai.com/v1
QA_AI_MODEL=gpt-4o-mini

QA_AI_TIMEOUT_SECONDS=30
